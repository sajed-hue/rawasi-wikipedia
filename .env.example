# Heritage Frontend — environment template.
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# All VITE_* values are embedded PUBLICLY in the built client bundle.
# NEVER put backend secrets here (service-account JSON, DB strings, private keys).

# Base URL of the ASP.NET Core Heritage API — no trailing slash.
# Dev default from the backend docs: https://localhost:7111 (or http://localhost:5012)
VITE_API_BASE_URL=https://localhost:7111

# Firebase Web (client) config.
# Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
